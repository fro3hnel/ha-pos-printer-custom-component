      "invalid_printer_name": {
        "title": "Druckername sollte neu konfiguriert werden",
        "description": "Der konfigurierte Druckername `{printer_name}` ist für MQTT-Themen ungeeignet. Ändere die Kennung auf der Bridge und entferne den Integrationseintrag; füge ihn danach neu hinzu. Verwende nur Kleinbuchstaben, Zahlen, Unterstriche und Bindestriche."
      },
      "outdated_bridge_version": {
        "title": "Bridge-Software ist veraltet",
        "description": "Die Bridge für `{printer_name}` meldet Version `{bridge_version}`. Aktualisiere die Raspberry-Pi-Bridge auf mindestens `{minimum_version}`, damit sie zur installierten Home-Assistant-Integration passt."
      },
      "legacy_mqtt_discovery": {
        "title": "Alte MQTT-Drucker-Entities sind noch vorhanden",
        "description": "Für {printer_name} sind noch MQTT-Discovery-Entities einer älteren Bridge vorhanden. Aktualisiere und starte die Bridge neu, damit sie die veraltete retained Discovery-Konfiguration entfernt. Falls Home Assistant danach noch ein verwaistes MQTT-Gerät zeigt, entferne es manuell."
      }
